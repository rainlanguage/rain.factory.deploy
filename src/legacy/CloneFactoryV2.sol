// by cyclo.sol on Flare and Arbitrum). Compiled once from rain.factory at the
// commit those deployments were built from: solc 0.8.25, evm paris, optimizer
// 100000 runs, CBOR appendix carrying only the solc version. The source is not
// in this repo; the bytes are the record.
bytes constant CLONE_FACTORY_V2_CREATION_CODE =
    hex"";

// keccak256 of the deployed runtime code with its CBOR appendix trimmed.
bytes32 constant CLONE_FACTORY_V2_TRIMMED_CODEHASH =
    bytes32(0x7b085ca3e5c659da29caf26d23e7b72fd4fdbc59aa6b5611cf3918c4586ec73a);
